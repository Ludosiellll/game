<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build: Play updates the app, so no installing of packages and no update receiver; no asking for the
     battery exemption (Play allows it only to a few kinds of apps — the settings list is opened instead). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <application>
        <receiver android:name=".update.UpdateReceiver" tools:node="remove" />
    </application>
</manifest>
